#!/bin/sh
# PinBridge commit-msg 钩子：本地拦截不合规的提交信息。
#
# 为什么要在本地拦：CI 里的 commit-lint 会失败，但那时候 PR 已经提出来了，
# 改提交信息要 force-push，容易把别人正在看的 review 搞乱。
# 本地 5 毫秒能拦下来的事，不要在 CI 上处理。
#
# 安装：pwsh scripts/bootstrap.ps1 -InstallHooks
#     或  git config core.hooksPath scripts/githooks
#
# 规则来自 docs/dev/commit-convention.md。

msg_file="$1"

# 跳过 merge / revert / fixup 等自动生成的提交
first_line=$(head -n 1 "$msg_file")
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*|amend!*)
    exit 0
    ;;
esac

pattern='^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9_.-]+\))?!?: .+'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  cat >&2 <<EOF
✗ 提交信息不符合 Conventional Commits 规范：

    $first_line

  正确形式：<type>(<scope>): <subject>
    type  : feat fix perf refactor docs test build ci chore revert
    scope : core proto hub client mcp cli trace agent sys abi python desktop scripts docs ci repo deps pin

  示例：feat(trace): 折叠连续重复事件为 EVENT_REPEAT 记录
  完整规则见 docs/dev/commit-convention.md（git commit 时会带出模板）
EOF
  exit 1
fi

# 标题长度：按**显示列**算，中文按 2 列。
#
# 为什么不用 `wc -c`：那是字节数，一个汉字占 3 字节，
# 于是"很短的合法中文标题"会被误判为超长——而 hooks 一旦出现误报，
# 大家就会开始统一使用 `--no-verify`，那这个钩子就彻底废了。
#
# 也不用 `wc -m`：在 C locale 下它退化成字节数，结论不可靠。
# 这里直接按 UTF-8 结构数：ASCII 记 1 列，三字节及以上（CJK/全角）记 2 列，
# 两字节（拉丁重音等）记 1 列。与 locale 无关。
width=$(printf '%s' "$first_line" | LC_ALL=C od -An -tu1 -v \
  | tr -s ' \n' '\n' | awk '
      NF == 0 { next }
      {
        b = $1
        if (b < 128)            { w += 1 }   # ASCII
        else if (b < 192)       { next }     # UTF-8 连续字节，不单独计数
        else if (b < 224)       { w += 1 }   # 2 字节（拉丁重音等）
        else                    { w += 2 }   # 3~4 字节（CJK / 全角）
      }
      END { print w + 0 }')
if [ "$width" -gt 72 ]; then
  printf '✗ 标题过长（%s 显示列，上限 72；中文按 2 列计）：%s\n' "$width" "$first_line" >&2
  printf '  把细节移到正文里，标题只留"做了什么"这一个动作。\n' >&2
  exit 1
fi

case "$first_line" in
  *.) printf '✗ 首行不要以句号结尾：%s\n' "$first_line" >&2; exit 1 ;;
esac

# 非 ASCII 首行也允许（本项目文档是中文），但提示一下：提交信息要能被 grep。
if printf '%s' "$first_line" | grep -qP '[^\x00-\x7F]' 2>/dev/null; then
  : # 允许中文提交信息：项目文档语言就是中文
fi

exit 0

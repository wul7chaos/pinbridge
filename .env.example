# PinBridge 本地环境变量示例
#
# 用法：
#   Copy-Item .env.example .env      # Windows
#   cp .env.example .env             # Linux/macOS
# 然后按需修改。**.env 永不入库**（见 .gitignore）。
#
# 注意：这些变量只影响本地开发体验，不影响任何协议或轨迹格式。
# 用环境变量而不是配置文件，是为了让"临时改一下"不需要动仓库里的文件。

# ---------------------------------------------------------------- 日志
# 日志级别：trace | debug | info | warn | error
PINBRIDGE_LOG=info
# 日志格式：text（人读）| json（机器读，便于 CI 里 grep）
PINBRIDGE_LOG_FORMAT=text

# -------------------------------------------------------------- 轨迹
# 轨迹输出目录。默认是系统临时目录下的 pinbridge-traces。
# 注意：轨迹可能包含目标内存片段与字符串，别放在会被同步的目录里。
PINBRIDGE_TRACE_DIR=

# 默认压缩档位：none | repeat | repeat+delta
# 强烈建议保持 repeat+delta：VMP 场景下体积差异是几个数量级。
PINBRIDGE_TRACE_PROFILE=repeat+delta

# 事件通道容量（条）。满了按 DropOldest 处理并**计数上报**。
PINBRIDGE_CHANNEL_CAPACITY=65536

# 脚本单次执行的时间预算（毫秒）。超时后脚本被标记 TimedOut 并强制卸载。
PINBRIDGE_SCRIPT_BUDGET_MS=5000

# -------------------------------------------------------------- 安全
# agent 链路只允许回环地址。这个变量**只控制端口**，不能控制绑定地址——
# 把调试能力暴露到网络上不是可配置项（见 docs/architecture/security-model.md）。
PINBRIDGE_AGENT_PORT=0

# 是否在启动时打印能力集与持有者（便于人工核对 AI 到底拿到了什么）
PINBRIDGE_VERBOSE_CAPABILITIES=true

# -------------------------------------------------------------- 开发
# 是否允许对未实现的能力返回 not_supported（M0 期间必须是 true）
# 设为 false 会让桩函数直接报错退出——用来验证"我们是否依赖了桩的宽容行为"。
PINBRIDGE_ALLOW_STUBS=true

# 构建/测试相关
RUST_BACKTRACE=1
RUST_LOG=pinbridge=debug

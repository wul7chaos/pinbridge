# 默认：文本文件统一 LF，检出时不做平台转换（Windows 上 Rust/Python 在 CRLF 下会误报 diff）
* text=auto eol=lf

# 明确二进制，避免 git 试图做行尾/编码转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.gz        binary
*.zst       binary
*.pbt       binary
*.dll       binary
*.exe       binary
*.so        binary
*.dylib     binary
*.lib       binary
*.pdb       binary
*.pyc       binary
*.bin       binary
*.wasm      binary

# 强制 LF 的脚本（在 Linux/macOS CI 上必须可执行）
*.sh        text eol=lf
*.bash      text eol=lf
Justfile    text eol=lf
justfile    text eol=lf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# 这些文件需要按语言标记以便 GitHub 语法高亮
Cargo.lock             text eol=lf
*.toml                 text eol=lf
*.rs                   text eol=lf
*.py                   text eol=lf
*.md                   text eol=lf
*.json                 text eol=lf
*.yml                  text eol=lf
*.yaml                 text eol=lf

# 语言统计：把 .github 与生成物排除，避免污染 repo 语言构成
.github/*              linguist-documentation
docs/**                linguist-documentation
python/**              linguist-language=Python
